<?xml version="1.0" encoding="utf-8"?>
<!--
  Legacy fullBackupContent (API 23–30). Paired with allowBackup=false;
  kept explicit so a future flip to allowBackup=true does not silently
  include WebView/localStorage domains without review (S14–S16).
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
